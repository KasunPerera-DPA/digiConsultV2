---
import { Icon } from 'astro-icon/components';

const marketingServices = [
  { 
    title: "Digital & Growth", 
    items: ["Digital & Performance Marketing", "Marketing Analytics & Operations", "Social Media & Community Management"] 
  },
  { 
    title: "Creative Services", 
    items: ["Content Creation", "Creative Design Roles", "Project-based Support via Partners"] 
  }
];

const lpoServices = [
  { 
    title: "Legal Support", 
    items: ["Document Management & Preparation", "Legal Research & Analysis", "Administrative Support & Scheduling"] 
  },
  { 
    title: "Custom Solutions", 
    items: ["Specialized Legal Functions", "Customized Client Workflows"] 
  }
];
---

<section class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="mb-32">
      <div class="flex items-center gap-4 mb-12">
        <div class="w-16 h-16 rounded-2xl bg-orange-600/10 flex items-center justify-center text-brand-orange">
          <Icon name="mdi:bullhorn-variant" class="w-10 h-10" />
        </div>
        <div>
          <h2 class="text-3xl font-bold text-brand-blue">Marketing</h2>
          <p class="text-brand-gray-medium">Performance-driven talent to support your growth initiatives.</p>
        </div>
      </div>
      
      <div class="grid md:grid-cols-2 gap-8">
        {marketingServices.map(group => (
          <div class="bg-white p-8 rounded-2xl border-t-4 border-brand-orange shadow-sm">
            <h3 class="font-bold text-brand-blue mb-6 uppercase text-sm tracking-widest">{group.title}</h3>
            <ul class="space-y-4">
              {group.items.map(item => (
                <li class="flex items-start gap-3 text-sm text-brand-gray-medium">
                  <Icon name="mdi:trending-up" class="w-5 h-5 text-brand-orange" />
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div>
      <div class="flex items-center gap-4 mb-12">
        <div class="w-16 h-16 rounded-2xl bg-slate-700/10 flex items-center justify-center text-slate-700">
          <Icon name="mdi:scale-balance" class="w-10 h-10" />
        </div>
        <div>
          <h2 class="text-3xl font-bold text-brand-blue">Legal Process Outsourcing</h2>
          <p class="text-brand-gray-medium">Structured and reliable support to streamline legal operations.</p>
        </div>
      </div>
      
      <div class="grid md:grid-cols-2 gap-8">
        {lpoServices.map(group => (
          <div class="bg-white p-8 rounded-2xl border-t-4 border-slate-700 shadow-sm">
            <h3 class="font-bold text-brand-blue mb-6 uppercase text-sm tracking-widest">{group.title}</h3>
            <ul class="space-y-4">
              {group.items.map(item => (
                <li class="flex items-start gap-3 text-sm text-brand-gray-medium">
                  <Icon name="mdi:file-certificate-outline" class="w-5 h-5 text-slate-700" />
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-20 p-8 bg-blue-50 rounded-xl border border-blue-100 flex flex-col md:flex-row items-center gap-6">
      <Icon name="mdi:shield-check" class="w-12 h-12 text-blue-600 flex-shrink-0" />
      <p class="text-sm text-blue-900 leading-relaxed">
        <strong>Legal & Regulatory Compliance:</strong> We strictly adhere to all Sri Lankan laws and regulatory requirements, ensuring complete transparency and peace of mind for both our clients and employees .
      </p>
    </div>

  </div>
</section>