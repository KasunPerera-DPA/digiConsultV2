---
import { Icon } from 'astro-icon/components';
---

  <section class="py-20 bg-brand-navy text-white text-center relative overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')]"></div>
    <div class="max-w-4xl mx-auto px-4 relative z-10">
      <h1 class="text-4xl lg:text-5xl font-bold mb-6">Build Your Team</h1>
      <p class="text-xl opacity-90 leading-relaxed">
        We provide high-quality talent across key business functions, enabling you to focus on strategy while we support execution with skilled professionals and flexible delivery models.
      </p>
    </div>
  </section>