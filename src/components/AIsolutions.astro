---
import { Icon } from 'astro-icon/components';

const aiCapabilities = [
  {
    title: "AI Strategy & Advisory",
    desc: "We assess opportunities, define use cases, and build a clear roadmap aligned with your business goals.",
    icon: "mdi:compass-outline"
  },
  {
    title: "AI Solution Design",
    desc: "We design the right solution using the best models, data, and technology for your specific use case.",
    icon: "mdi:cube-outline"
  },
  {
    title: "AI Development & Integration",
    desc: "We build, integrate, and deploy AI solutions that seamlessly fit into your existing systems.",
    icon: "mdi:code-tags"
  },
  {
    title: "Ongoing Support & Optimization",
    desc: "We monitor performance, optimize models, and iterate to ensure continuous improvement.",
    icon: "mdi:chart-timeline-variant"
  }
];

const approach = [
  { step: "01", label: "Discover", desc: "Understand your business challenges and identify high-impact AI opportunities." },
  { step: "02", label: "Define", desc: "Validate use cases, define success metrics, and create a clear implementation plan." },
  { step: "03", label: "Develop", desc: "Build and test the solution with agility, transparency, and a focus on quality." },
  { step: "04", label: "Deliver & Scale", desc: "Deploy, measure impact, and scale what works across your organization." }
];
---

  <section class="py-20 bg-brand-navy text-white text-center relative overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')]"></div>
    <div class="max-w-4xl mx-auto px-4 relative z-10">
        <h1 class="text-5xl lg:text-6xl font-bold text-white mb-6">
          AI Consultancy & Projects that <span class="text-brand-orange italic">Drive Impact</span>
        </h1>
        <p class="text-brand-gray-light text-lg mb-8 opacity-90">
          We help businesses unlock the value of AI. From strategy and roadmap to end-to-end delivery. we turn ideas into intelligent, measurable solutions.
        </p>
    </div>
  </section> 

<section class="py-24 bg-white relative overflow-hidden">
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full opacity-[0.03] pointer-events-none">
    <Icon name="mdi:dots-grid" class="w-full h-full text-brand-blue" />
  </div>

  <div class="max-w-7xl mx-auto px-4 text-center relative z-10">
    <p class="text-brand-orange font-bold uppercase text-xs tracking-widest mb-4">What We Do</p>
    <h2 class="text-4xl font-bold text-brand-blue mb-16">We advise. We build. We deliver.</h2>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-2 gap-8"> {aiCapabilities.map(cap => (
        <div class="p-10 rounded-3xl bg-brand-gray-light border border-brand-gray-medium hover:border-brand-orange/30 hover:bg-white hover:shadow-[0_20px_50px_rgba(31,58,95,0.1)] transition-all duration-500 text-left group relative overflow-hidden">
          
          <div class="absolute top-0 left-0 w-2 h-0 bg-brand-orange group-hover:h-full transition-all duration-500"></div>

          <div class="flex items-start gap-6">
            <div class="p-4 rounded-2xl bg-brand-gray-light shadow-sm text-brand-blue group-hover:text-brand-orange group-hover:scale-110 transition-all duration-500">
              <Icon name={cap.icon} class="w-8 h-8" />
            </div>
            
            <div>
              <h3 class="text-xl font-bold text-brand-blue mb-4">{cap.title}</h3>
              <p class="text-brand-gray-medium leading-relaxed">
                {cap.desc}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

  <section id="approach" class="py-24 bg-brand-gray-light">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid lg:grid-cols-3 gap-12 items-center mb-16">
        <div class="lg:col-span-1">
          <p class="text-brand-orange font-bold uppercase text-xs tracking-widest mb-4">Our Approach</p>
          <h2 class="text-4xl font-bold text-brand-blue">A proven approach from idea to impact.</h2>
        </div>
        <div class="lg:col-span-2">
          <p class="text-brand-gray-medium leading-relaxed">
            We follow a collaborative, outcome-driven process to ensure every AI initiative delivers tangible business value and scales your operations efficiently.
          </p>
        </div>
      </div>

      <div class="grid md:grid-cols-4 gap-4">
        {approach.map(step => (
          <div class="bg-white p-8 rounded-xl relative group overflow-hidden">
            <span class="absolute top-4 right-4 text-brand-blue/5 text-6xl font-bold group-hover:text-brand-orange/10 transition-colors">{step.step}</span>
            <div class="w-8 h-8 bg-brand-blue text-white rounded-full flex items-center justify-center text-xs font-bold mb-6">{step.step}</div>
            <h4 class="font-bold text-brand-blue mb-3">{step.label}</h4>
            <p class="text-xs text-brand-gray-medium leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <section class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 text-center">
    <p class="text-brand-orange font-bold uppercase text-xs tracking-widest mb-4">Real Impact</p>
    <h2 class="text-3xl font-bold text-brand-blue mb-16">AI solutions. Real business results.</h2>
    
    <div class="grid lg:grid-cols-3 gap-8">
      <div class="bg-brand-gray-light p-10 rounded-3xl text-left border border-transparent hover:border-brand-blue/10 transition-all">
        <Icon name="mdi:bank-outline" class="w-10 h-10 text-brand-blue mb-6" />
        <span class="text-[10px] font-bold text-brand-gray-medium uppercase tracking-widest">Finance</span>
        <h4 class="text-xl font-bold text-brand-blue mt-2 mb-4">Intelligent Document Processing</h4>
        <p class="text-sm text-brand-gray-medium leading-relaxed mb-6">
          Automated extraction and verification of financial data, reducing manual processing time by up to 70%.
        </p>
        <!-- <div class="text-brand-blue font-bold text-sm">View Implementation Model →</div> -->
      </div>

      <div class="bg-brand-gray-light p-10 rounded-3xl text-left border border-transparent hover:border-brand-blue/10 transition-all">
        <Icon name="mdi:code-braces" class="w-10 h-10 text-brand-blue mb-6" />
        <span class="text-[10px] font-bold text-brand-gray-medium uppercase tracking-widest">Software Services</span>
        <h4 class="text-xl font-bold text-brand-blue mt-2 mb-4">AI-Augmented QA Testing</h4>
        <p class="text-sm text-brand-gray-medium leading-relaxed mb-6">
          Leveraging AI to generate test cases and predict software bugs, accelerating deployment cycles by 30%.
        </p>
        <!-- <div class="text-brand-blue font-bold text-sm">View Implementation Model →</div> -->
      </div>

      <div class="bg-brand-gray-light p-10 rounded-3xl text-left border border-transparent hover:border-brand-blue/10 transition-all">
        <Icon name="mdi:account-group-outline" class="w-10 h-10 text-brand-blue mb-6" />
        <span class="text-[10px] font-bold text-brand-gray-medium uppercase tracking-widest">Operations</span>
        <h4 class="text-xl font-bold text-brand-blue mt-2 mb-4">Smart Resource Allocation</h4>
        <p class="text-sm text-brand-gray-medium leading-relaxed mb-6">
          Predictive analytics to manage offshore team workloads, ensuring 100% capacity utilization.
        </p>
        <!-- <div class="text-brand-blue font-bold text-sm">View Implementation Model →</div> -->
      </div>
    </div>
  </div>
</section>