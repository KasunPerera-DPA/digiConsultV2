---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import HeroBack from "../assets/HeroBack.jpg";
import HeroBack2 from "../assets/HeroBack2.jpg";
---

<section class="relative bg-white overflow-hidden">
  <!-- <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20 lg:pb-32"> 
   <div class="w-5xl mx-auto px-2 pb-20 lg:pb-32">-->

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div class="z-10">
        <h1 class="text-brand-blue text-5xl font-bold leading-tight mb-6">
          Build Your Team. <br />
          <span class="text-brand-navy">Scale Without Limits.</span>
        </h1>

        <p class="text-brand-navy text-md leading-relaxed mb-10 max-w-xl">
          We help businesses scale efficiently by providing qualified, dedicated
          professionals who seamlessly integrate into your existing teams. Get
          the flexibility to grow without the overhead of traditional hiring.
        </p>

        <div class="grid grid-cols-3 gap-4 mb-5">
          <div class="text-center">
            <div class="text-brand-blue mb-2 flex justify-center">
              <Icon name="mdi:account-group-outline" class="w-8 h-8" />
            </div>
            <p class="font-bold text-brand-blue text-sm">
              Skilled Professionals
            </p>
          </div>
          <div class="text-center">
            <div class="text-brand-blue mb-2 flex justify-center">
              <Icon name="mdi:sync" class="w-8 h-8" />
            </div>
            <p class="font-bold text-brand-blue text-sm">Flexible Models</p>
          </div>
          <div class="text-center">
            <div class="text-brand-blue mb-2 flex justify-center">
              <Icon name="mdi:trending-up" class="w-8 h-8" />
            </div>
            <p class="font-bold text-brand-blue text-sm">
              Cost-effective Delivery
            </p>
          </div>
        </div>

        <!-- 40% card -->
        <div
          class="w-full bg-white rounded-2xl py-4 px-8 border border-brand-blue/20 transition-all duration-300 group
            hover:-translate-y-2 shadow-[0_0_25px_rgba(31,58,95,0.15)] hover:shadow-[0_0_40px_rgba(31,58,95,0.3)]"
        >
          <div class="flex items-center gap-4 mb-6">
            <div
              class="w-14 h-14 bg-brand-orange/10 rounded-full flex items-center justify-center text-brand-orange group-hover:bg-brand-orange group-hover:text-white transition-colors duration-300"
            >
              <Icon name="mdi:trending-down" class="w-8 h-8" />
            </div>
            <span
              class="text-4xl lg:text-5xl font-bold text-brand-blue tracking-tighter"
            >
              40%
            </span>

            <h3
              class="text-lg font-bold text-brand-blue uppercase tracking-wide"
            >
              Cost Efficiency
            </h3>
          </div>
          <p class="text-brand-gray-medium text-sm leading-relaxed">
            Reduce your back-office operational costs by <span
              class="text-brand-blue font-semibold">40%</span
            > with DigiConsult, while maintaining the highest quality standards.
          </p>

          <div
            class="mt-6 w-12 h-1 bg-brand-orange rounded-full group-hover:w-24 transition-all duration-500"
          >
          </div>
        </div>

        <!-- 40% card -->

        <!-- <div class="flex flex-wrap gap-4">
          <a href="#" class="bg-brand-orange text-white px-8 py-4 rounded-md font-bold uppercase text-sm hover:shadow-lg transition-all flex items-center gap-2">
            Get Started <Icon name="mdi:chevron-right" class="w-5 h-5" />
          </a>
           <a href="#" class="border-2 border-brand-blue text-brand-blue px-8 py-4 rounded-md font-bold uppercase text-sm hover:bg-brand-gray-light transition-all">
            Book a Consultation
          </a> 
        </div> -->
      </div>

      <div class="relative hidden lg:block">
        <div
          class="aspect-square bg-gradient-to-br from-brand-blue via-brand-navy to-black shadow-2xl overflow-hidden flex items-center justify-center"
        >
          <Image
            src={HeroBack2}
            alt="Hero Background"
            class="h-full w-auto object-cover object-right opacity-90"
          />
        </div>

        <!-- <div class="absolute -bottom-6 -left-6 bg-brand-navy text-white p-6 rounded-xl shadow-xl max-w-xs border-l-4 border-brand-orange">
          <p class="text-sm font-medium leading-relaxed">
            "Top Talent. Seamless Integration. Stronger Business Outcomes."
          </p>
        </div> -->
      </div>
    </div>
  </div>
</section>
