---
import { Icon } from 'astro-icon/components';
---

<section class="py-24 bg-brand-navy relative overflow-hidden">
  <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-purple-900/20 to-transparent"></div>
  <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-brand-blue/10 rounded-full blur-3xl"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-brand-orange text-xs font-bold uppercase tracking-widest mb-6">
          <Icon name="mdi:sparkles" class="w-4 h-4" />
          Innovation Pillar
        </div>
        <h2 class="text-4xl lg:text-5xl font-bold text-white mb-6 leading-tight">
          Augment Your Workflow with <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-orange to-purple-400">Next-Gen AI</span>
        </h2>
        <p class="text-brand-gray-light text-lg mb-8 leading-relaxed opacity-90">
          We help you bridge the gap between traditional operations and AI efficiency. Our specialized IT talent doesn't just fill roles—they integrate intelligent tools that multiply your team's output.
        </p>
        
        <div class="grid sm:grid-cols-2 gap-6">
          <div class="flex items-start gap-3">
            <Icon name="mdi:brain" class="text-brand-orange w-6 h-6 mt-1" />
            <div>
              <h4 class="text-white font-bold text-sm uppercase">AI Consultation</h4>
              <p class="text-xs text-brand-gray-light">Strategic identification of automation opportunities.</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <Icon name="mdi:xml" class="text-brand-orange w-6 h-6 mt-1" />
            <div>
              <h4 class="text-white font-bold text-sm uppercase">Custom Integration</h4>
              <p class="text-xs text-brand-gray-light">Seamless tool deployment into your current stack.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="relative">
        <div class="bg-white/5 backdrop-blur-md border border-white/10 p-8 rounded-3xl shadow-2xl relative z-20">
          <div class="flex justify-between items-center mb-8">
            <div class="w-12 h-12 bg-brand-orange rounded-xl flex items-center justify-center text-white">
              <Icon name="mdi:robot-confused-outline" class="w-7 h-7" />
            </div>
            <span class="text-white/30 font-mono text-xs uppercase tracking-widest">System Status: Active</span>
          </div>
          
          <h3 class="text-2xl font-bold text-white mb-4 italic">"Efficiency isn't just about more people; it's about smarter tools."</h3>
          <p class="text-sm text-brand-gray-light mb-6">
            Leverage our vetted QA and Software Engineers who specialize in **AI Augmentation Software Services**.
          </p>
          
          <div class="space-y-4">
            <div class="h-2 w-full bg-white/10 rounded-full overflow-hidden">
              <div class="h-full bg-brand-orange w-[85%] animate-pulse"></div>
            </div>
            <div class="flex justify-between text-[10px] text-white/50 uppercase font-bold">
              <span>Operational Speed</span>
              <span>+85% Improvement</span>
            </div>
          </div>
        </div>
        
        <div class="absolute inset-0 bg-brand-blue/30 blur-[100px] rounded-full"></div>
      </div>

    </div>
  </div>
</section>