---
import { Image } from "astro:assets";
import logoImage from "../assets/logo.png";
import { Icon } from "astro-icon/components";
import "../styles/global.css";
---

<nav class="bg-white border-b border-brand-gray-light sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      
      <div class="flex-shrink-0 flex items-center">
        <a href="/" class="flex items-center gap-2">
          <Image src={logoImage} alt="DigiConsult Logo" width={50} height={50} class="w-auto h-10 lg:h-12" />
          <span class="text-brand-orange font-bold text-xl lg:text-2xl tracking-tight hidden xs:block">
            Digi<span class="text-brand-blue">Consult</span>
          </span>
        </a>
      </div>

      <div class="hidden md:flex items-center space-x-6 lg:space-x-8">
        <a href="/" class="text-brand-blue hover:text-brand-orange font-semibold transition-colors">Home</a>
        <a href="/about_us" class="text-brand-gray-medium hover:text-brand-blue font-medium transition-colors">About Us</a>
        <a href="/services" class="text-brand-gray-medium hover:text-brand-blue font-medium transition-colors">Services</a>
        <a href="/ai_solutions" class="text-brand-blue font-bold hover:text-brand-orange transition-colors">AI Solutions</a>
        <a href="/contact" class="bg-brand-orange text-white px-6 py-2.5 rounded-full font-semibold uppercase text-sm hover:shadow-lg transition-all">Reach Us</a>
      </div>

      <div class="md:hidden flex items-center">
        <button id="mobile-menu-button" class="text-brand-blue p-2" aria-label="Menu">
          <Icon name="mdi:menu" class="w-8 h-8" />
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="hidden fixed inset-0 z-[60] bg-brand-navy p-6 transition-all duration-300">
    <div class="flex justify-between items-center mb-12">
      <span class="text-white font-bold text-2xl">Digi<span class="text-brand-orange">Consult</span></span>
      <button id="close-menu" class="text-white p-2">
        <Icon name="mdi:close" class="w-8 h-8" />
      </button>
    </div>
    
    <div class="flex flex-col space-y-6 text-center">
      <a href="/" class="text-white text-xl font-bold border-b border-white/10 pb-4">Home</a>
      <a href="/about_us" class="text-white/80 text-xl font-medium border-b border-white/10 pb-4">About Us</a>
      <a href="/services" class="text-white/80 text-xl font-medium border-b border-white/10 pb-4">Services</a>
      <a href="/ai_solutions" class="text-brand-orange text-xl font-bold border-b border-white/10 pb-4">AI Solutions</a>
      <a href="/contact" class="bg-brand-orange text-white py-4 rounded-xl font-bold uppercase tracking-widest mt-4">Reach Us</a>
    </div>
  </div>
</nav>

<script is:inline>
  const btn = document.getElementById('mobile-menu-button');
  const closeBtn = document.getElementById('close-menu');
  const menu = document.getElementById('mobile-menu');

  btn.addEventListener('click', () => {
    menu.classList.remove('hidden');
    document.body.style.overflow = 'hidden'; // Stop scrolling when menu is open
  });

  closeBtn.addEventListener('click', () => {
    menu.classList.add('hidden');
    document.body.style.overflow = 'auto'; // Restore scrolling
  });
</script>