---
import { Image } from 'astro:assets';
import logoImage from '../assets/logo.png';
import '../styles/global.css'   
---

<nav class="bg-white border-b border-brand-gray-light sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      
      <div class="flex-shrink-0 flex items-center">
        <a href="/" class="flex items-center gap-2">
          <Image 
            src={logoImage} 
            alt="DigiConsult Logo" 
            width={50} 
            height={50} 
            class="w-auto h-12"
          />
          <span class="text-brand-orange font-bold text-2xl tracking-tight hidden sm:block">
            Digi<span class="text-brand-blue">Consult</span>
          </span>
        </a>
      </div>

      <div class="hidden md:flex items-center space-x-8">
        <a href="/welcomepage" class="text-brand-blue hover:text-brand-orange font-semibold hover:font-bold transition-colors">
          Home
        </a>
        <a href="/welcomepage" class="text-brand-gray-medium hover:text-brand-blue font-medium transition-colors">
          Services
        </a>
        
        <a 
          href="/welcomepage" 
          class="bg-brand-orange text-white px-6 py-2.5 rounded-full font-semibold uppercase text-sm hover:opacity-90 transition-all shadow-md"
        >
          Reach Us
        </a>
      </div>

    </div>
  </div>
</nav>